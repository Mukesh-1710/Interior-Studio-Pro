#!/bin/sh
# Simplified Maven Wrapper for Unix
MVN_VERSION="3.9.6"
MVN_DIR="./.maven"
MVN_URL="https://archive.apache.org/dist/maven/maven-3/$MVN_VERSION/binaries/apache-maven-$MVN_VERSION-bin.zip"

if [ ! -d "$MVN_DIR/apache-maven-$MVN_VERSION" ]; then
    echo "Maven not found. Downloading Maven $MVN_VERSION..."
    mkdir -p "$MVN_DIR"
    curl -L "$MVN_URL" -o "$MVN_DIR/maven.zip"
    unzip "$MVN_DIR/maven.zip" -d "$MVN_DIR"
    rm "$MVN_DIR/maven.zip"
fi

export M2_HOME="$MVN_DIR/apache-maven-$MVN_VERSION"
export PATH="$M2_HOME/bin:$PATH"

mvn "$@"
